# The chain the app serves. Must have an entry in NEXT_PUBLIC_CHAINS below or
# the app throws at startup.
NEXT_PUBLIC_CHAIN_ID=

# Per-chain contract + deposit-token config, JSON keyed by chain id. Keep it on
# ONE line: `make deploy` rewrites this line in place with the local anvil
# deployment. Shape (add an entry per chain this deployment serves):
#
#   {
#     "100": {
#       "savingCircles": "0x...",
#       "savingCirclesViewer": "0x...",
#       "automaticSavingCircles": "0x...",
#       "contractCreationBlock": "37000000",
#       "goalSavings": "0x...",
#       "depositToken": { "address": "0x...", "symbol": "BREAD", "decimals": 18 }
#     },
#     "42220": {
#       "savingCircles": "0x...",
#       "savingCirclesViewer": "0x...",
#       "automaticSavingCircles": "0x...",
#       "contractCreationBlock": "31000000",
#       "depositToken": {
#         "address": "0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e",
#         "symbol": "USDT",
#         "decimals": 6
#       }
#     }
#   }
NEXT_PUBLIC_CHAINS=

# Deployment tier. Required, no default — one of: local, development, prod.
# The chain is not part of this value; see NEXT_PUBLIC_CHAINS above.
NEXT_PUBLIC_NODE_ENV=local

NEXT_PUBLIC_DEPOSIT_INTERVALS='[
  {"id":"5mins","label":"5 minutes","seconds":300},
  {"id":"10mins","label":"10 minutes","seconds":600},
  {"id":"30mins","label":"30 minutes","seconds":1800},
  {"id":"1day","label":"1 day","seconds":86400,"unit":"day"},
  {"id":"3days","label":"3 days","seconds":259200},
  {"id":"1week","label":"weekly","seconds":604800,"description":"7 days"},
  {"id":"2weeks","label":"2 weeks","seconds":1209600,"description":"14 days"},
  {"id":"3weeks","label":"3 weeks","seconds":1814400,"description":"21 days"},
  {"id":"1month","label":"monthly","seconds":2592000,"description":"30 days"}
]'

# https://dashboard.walletconnect.com/sign-in
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# https://www.alchemy.com/
NEXT_PUBLIC_ALCHEMY_API_KEY_ETHEREUM_MAINNET=

# https://spoo.me/
SPOO_TOKEN= 

# https://console.upstash.com/auth/sign-in
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# https://dashboard.privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Sepolia embedded-wallet auto-funding
SEPOLIA_RPC_URL=
AUTOMATIC_FUNDING_PRIVATE_KEY=

# MiniPay / Celo deployments (issue #154). A Celo deployment sets
# NEXT_PUBLIC_CHAIN_ID=42220 (or 11142220 for Celo Sepolia); its contracts and
# deposit stablecoin go in that chain's NEXT_PUBLIC_CHAINS entry above.
# Optional CIP-64 feeCurrency override; defaults to the adapter matching the
# deposit token (USDT/USDC/USDm on Celo mainnet).
NEXT_PUBLIC_CELO_FEE_CURRENCY=
# HMAC secret for MiniPay session tokens (any long random string); required
# only when serving MiniPay users.
MINIPAY_SESSION_SECRET=

# Privy app secret (Dashboard -> App settings -> Basics). Server-side only —
# never prefix it NEXT_PUBLIC_. Used to resolve which wallets a Privy account
# owns when authorizing an on-chain address; without it, an owner whose linked
# external wallet differs from the address cached in `users` cannot see their
# stack's join requests.
PRIVY_APP_SECRET=

# Feature gating (JSON, per deployment). Feature key absent or enabled=false -> hidden;
# addresses present -> only those wallets see it. Local always shows every feature.
# e.g. {"automaticClaim":{"enabled":true,"addresses":["0x6532665Cde5Cc99bbABf4Be4bbF178bD13CC849d"]}}
NEXT_PUBLIC_FEATURES=

# Supabase database URLs for migration pushes (pnpm db:push:<env>). Still one
# project per chain until the database consolidation lands.
# Contains the DB password - never commit real values. Get each from
# Dashboard -> Settings -> Database -> Connection string (URI, session pooler).
SUPABASE_DB_URL_LOCAL=
SUPABASE_DB_URL_LOCAL_CELO=
SUPABASE_DB_URL_DEVELOPMENT=
SUPABASE_DB_URL_DEVELOPMENT_CELO=
SUPABASE_DB_URL_PROD=
SUPABASE_DB_URL_PROD_CELO=

# TEMPORARY: set to 1 to log, after each write, the block the tx landed in
# against the block the RPC then serves reads from. Diagnosing stale reads on
# Celo after a transaction; remove with src/utils/debug-tx.ts.
NEXT_PUBLIC_DEBUG_TX=
