# auto populates after running `make deploy`
NEXT_PUBLIC_SAVING_CIRCLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_SAVING_CIRCLES_VIEWER_CONTRACT_ADDRESS=
NEXT_PUBLIC_AUTOMATIC_SAVING_CIRCLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_BREAD_TOKEN_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_SAVING_CIRCLES_CONTRACT_CREATION_BLOCK=

# Required, no default — must be one of: local, local-celo, development,
# development-celo, prod, prod-celo
NEXT_PUBLIC_NODE_ENV=local

NEXT_PUBLIC_DEPOSIT_INTERVALS='[
  {"id":"5mins","label":"5 minutes","seconds":300},
  {"id":"10mins","label":"10 minutes","seconds":600},
  {"id":"30mins","label":"30 minutes","seconds":1800},
  {"id":"1day","label":"1 day","seconds":86400,"unit":"day"},
  {"id":"3days","label":"3 days","seconds":259200},
  {"id":"1week","label":"weekly","seconds":604800,"description":"7 days"},
  {"id":"2weeks","label":"2 weeks","seconds":1209600,"description":"14 days"},
  {"id":"3weeks","label":"3 weeks","seconds":1814400,"description":"21 days"},
  {"id":"1month","label":"monthly","seconds":2592000,"description":"30 days"}
]'

# https://dashboard.walletconnect.com/sign-in
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# https://www.alchemy.com/
NEXT_PUBLIC_ALCHEMY_API_KEY_ETHEREUM_MAINNET=

# https://spoo.me/
SPOO_TOKEN= 

# https://console.upstash.com/auth/sign-in
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# https://dashboard.privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Sepolia embedded-wallet auto-funding
SEPOLIA_RPC_URL=
AUTOMATIC_FUNDING_PRIVATE_KEY=

# MiniPay / Celo deployments (issue #154). Defaults suit the Gnosis BREAD app;
# a Celo deployment sets NEXT_PUBLIC_CHAIN_ID=42220 (or 11142220 for Celo
# Sepolia), points NEXT_PUBLIC_BREAD_TOKEN_ADDRESS at the deposit stablecoin
# (USDT 0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e), and sets symbol/decimals.
NEXT_PUBLIC_DEPOSIT_TOKEN_SYMBOL=
NEXT_PUBLIC_DEPOSIT_TOKEN_DECIMALS=
# Optional CIP-64 feeCurrency override; defaults to the adapter matching the
# deposit token (USDT/USDC/USDm on Celo mainnet).
NEXT_PUBLIC_CELO_FEE_CURRENCY=
# HMAC secret for MiniPay session tokens (any long random string); required
# only when serving MiniPay users.
MINIPAY_SESSION_SECRET=

# Feature gating (JSON, per deployment). Feature key absent or enabled=false -> hidden;
# addresses present -> only those wallets see it. Local always shows every feature.
# e.g. {"automaticClaim":{"enabled":true,"addresses":["0x6532665Cde5Cc99bbABf4Be4bbF178bD13CC849d"]}}
NEXT_PUBLIC_FEATURES=

# Supabase database URLs for migration pushes (pnpm db:push:<env>).
# Contains the DB password - never commit real values. Get each from
# Dashboard -> Settings -> Database -> Connection string (URI, session pooler).
SUPABASE_DB_URL_LOCAL=
SUPABASE_DB_URL_DEVELOPMENT=
SUPABASE_DB_URL_DEMO=
SUPABASE_DB_URL_PROD=
