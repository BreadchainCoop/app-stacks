# Core contract values for GNOSIS mode.
# Keep these filled with your Gnosis deployment values.
# If you run `make deploy` locally, these are auto-updated for local testing.
NEXT_PUBLIC_SAVING_CIRCLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_SAVING_CIRCLES_VIEWER_CONTRACT_ADDRESS=
NEXT_PUBLIC_BREAD_TOKEN_ADDRESS=
NEXT_PUBLIC_DELEGATED_SAVING_CIRCLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_SAVING_CIRCLES_CONTRACT_CREATION_BLOCK=
# Informational only. App chain is selected with NEXT_PUBLIC_TARGET_NETWORK.
NEXT_PUBLIC_CHAIN_ID=100

# Single network switch:
# - gnosis  -> uses core vars above
# - sepolia -> uses NEXT_PUBLIC_SEPOLIA_* vars below
# - local   -> uses NEXT_PUBLIC_LOCAL_* vars below
NEXT_PUBLIC_TARGET_NETWORK=gnosis

# RPC overrides per network
NEXT_PUBLIC_LOCAL_RPC_URL=http://localhost:8545
NEXT_PUBLIC_GNOSIS_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Local-only contract values (used when NEXT_PUBLIC_TARGET_NETWORK=local)
NEXT_PUBLIC_LOCAL_SAVING_CIRCLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_LOCAL_SAVING_CIRCLES_VIEWER_CONTRACT_ADDRESS=
NEXT_PUBLIC_LOCAL_BREAD_TOKEN_ADDRESS=
NEXT_PUBLIC_LOCAL_DELEGATED_SAVING_CIRCLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_LOCAL_SAVING_CIRCLES_CONTRACT_CREATION_BLOCK=

# Sepolia-only contract values (used when NEXT_PUBLIC_TARGET_NETWORK=sepolia)
# Use proxy address for SAVING_CIRCLES_CONTRACT_ADDRESS (app write target).
NEXT_PUBLIC_SEPOLIA_SAVING_CIRCLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_SEPOLIA_SAVING_CIRCLES_VIEWER_CONTRACT_ADDRESS=
NEXT_PUBLIC_SEPOLIA_BREAD_TOKEN_ADDRESS=
NEXT_PUBLIC_SEPOLIA_DELEGATED_SAVING_CIRCLES_CONTRACT_ADDRESS=
NEXT_PUBLIC_SEPOLIA_SAVING_CIRCLES_CONTRACT_CREATION_BLOCK=

# Autopay / Lit configuration
# Public values used by the UI and typed-data authorization flow.
NEXT_PUBLIC_LIT_AUTOPAY_NETWORK=
NEXT_PUBLIC_LIT_AUTOPAY_POLICY_ID=

# Autopay worker configuration
# Server-side / local-only execution settings for the current worker MVP.
AUTOPAY_WORKER_RPC_URL=
AUTOPAY_WORKER_PRIVATE_KEY=
LIT_AUTOPAY_PKP_PUBLIC_KEY=
LIT_AUTOPAY_PKP_KEYSET_ID=naga-keyset1
LIT_AUTOPAY_USER_MAX_PRICE_WEI=200000000000000000
AUTOPAY_CRON_SECRET=

# UI runtime mode for shared components (keep production on hosted envs)
NEXT_PUBLIC_NODE_ENV=production

# https://dashboard.walletconnect.com/sign-in
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# https://www.alchemy.com/
NEXT_PUBLIC_ALCHEMY_API_KEY_ETHEREUM_MAINNET=

# https://spoo.me/
SPOO_TOKEN= 

# https://console.upstash.com/auth/sign-in
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# https://dashboard.privy.io/
# Public Privy app identifiers (safe in NEXT_PUBLIC vars)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Sepolia embedded-wallet auto-funding (server-side, token only)
# Token address source: NEXT_PUBLIC_SEPOLIA_BREAD_TOKEN_ADDRESS
SEPOLIA_AUTO_FUND_ENABLED=false
SEPOLIA_RPC_URL=
SEPOLIA_FUNDER_PRIVATE_KEY=
SEPOLIA_AUTO_FUND_AMOUNT_WEI=
