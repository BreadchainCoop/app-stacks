{
  "name": "breadcoop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "netlify:dev": "NODE_ENV=production netlify dev",
    "find-deadcode": "ts-prune | grep -v '(used in module)'",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "db:migration": "supabase migration new",
    "db:push:local": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL_LOCAL\"'",
    "db:push:local-celo": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL_LOCAL_CELO\"'",
    "db:push:local-all": "pnpm db:push:local && pnpm db:push:local-celo",
    "db:push:development": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL_DEVELOPMENT\"'",
    "db:push:development-celo": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL_DEVELOPMENT_CELO\"'",
    "db:push:development-all": "pnpm db:push:development && pnpm db:push:development-celo",
    "db:push:prod": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL_PROD\"'",
    "db:push:celo": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL_PROD_CELO\"'",
    "db:push:prod-all": "pnpm db:push:prod && pnpm db:push:celo"
  },
  "dependencies": {
    "@breadcoop/ui": "2.0.5",
    "@duneanalytics/client-sdk": "0.2.5",
    "@hookform/resolvers": "5.2.2",
    "@lifi/sdk": "3.16.3",
    "@lifi/widget": "3.40.12",
    "@mysten/sui": "2.16.2",
    "@next/third-parties": "15.5.14",
    "@phosphor-icons/react": "2.1.10",
    "@privy-io/react-auth": "3.18.0",
    "@privy-io/wagmi": "4.0.3",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tooltip": "1.2.8",
    "@rainbow-me/rainbowkit": "2.2.10",
    "@supabase/supabase-js": "2.99.3",
    "@tanstack/react-query": "5.91.2",
    "@upstash/redis": "1.37.0",
    "@wagmi/core": "2.22.1",
    "@zkp2p/sdk": "0.3.2",
    "blo": "2.0.0",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.3.1",
    "jose": "5.9.6",
    "next": "15.4.10",
    "obscenity": "0.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.71.2",
    "tailwind-merge": "3.5.0",
    "uuid": "13.0.0",
    "viem": "2.47.5",
    "wagmi": "2.19.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "7.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "15.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.2.2",
    "ts-prune": "0.10.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.0.0"
}
