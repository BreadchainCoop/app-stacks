# On-chain journey harness — environment. Copy to .env (gitignored) to override.
# NONE of these are read by the Next app or baked into any build; they are read
# only by the test process. Never put a real/funded key here.

# JSON-RPC the injected wallets sign/broadcast/read against (the anvil fork).
TEST_RPC_URL=http://localhost:8545

# Where the dev server (in local E2E wallet mode) is served.
TEST_BASE_URL=http://localhost:3001

# In-process signers. Defaults (set in run.sh) are anvil dev accounts #0/#1/#2 —
# public, auto-funded on the fork, deliberately not secrets.
# TEST_ADMIN_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# TEST_OWNER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# TEST_MEMBER_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Upstream Gnosis RPC anvil forks from (used by run.sh, never by the browser).
FORK_RPC_URL=https://rpc.gnosischain.com

# Slow every UI pause down (or speed it up) — 2 gives smoother GIFs.
# TEST_PACE=1

# Watch the run in a real window instead of headless.
# HEADED=1

# Use a specific Chromium binary instead of Playwright's managed one.
# PW_EXECUTABLE_PATH=/path/to/Chromium

# Prepend a node bin dir to PATH (e.g. an nvm install) before running.
# NODE_BIN=/Users/you/.nvm/versions/node/v23.5.0/bin
